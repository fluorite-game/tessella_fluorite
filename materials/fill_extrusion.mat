// SPDX-License-Identifier: Apache-2.0
//
// The fill-extrusion family: buildings with height.
//
// A wall vertex carries the footprint position and a packed normal whose parity says whether this
// corner sits at the building's base or its top. mbgl reads it as
//   t = mod(normal.x, 2.0)
//   z = t > 0 ? height : base
// so one vertex buffer describes both the ground ring and the roof ring, and the walls between.
//
// The lighting is mbgl's flat approximation rather than anything physical: a directional term from
// the normal plus the layer's own light colour and intensity, which is what gives the roofs and the
// two wall orientations their distinct shades. `vertical_gradient` and the pattern variants are not
// here yet.
//
// Placed by the shader like a line, and for the same reason: the base/height selection happens in
// tile units before the tile-to-clip step, and worldPosition in the object domain is already past
// the renderable's transform.
material {
    name : tessella_fill_extrusion,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    parameters : [
        { type : mat4,   name : matrix },
        { type : float4, name : color },
        { type : float,  name : opacity },
        { type : float,  name : base },
        { type : float,  name : height },
        { type : float,  name : heightFactor },
        { type : float3, name : lightColor },
        { type : float,  name : lightIntensity }
    ],
    requires : [ position, custom0 ],
    variables : [ shade ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec2 footprint = getPosition().xy;
        vec4 normalEd = getCustom0();

        // Parity of the packed normal's x selects the roof ring from the ground ring.
        float top = mod(normalEd.x, 2.0);
        float z = top > 0.0 ? materialParams.height : materialParams.base;

        // A wall's facing, from the packed normal. A zero normal is a roof, which takes full light.
        vec3 normal = normalEd.xyz;
        float lit = 1.0;
        if (normal.x != 0.0 || normal.y != 0.0) {
            vec2 facing = normalize(normal.xy);
            lit = 0.65 + 0.35 * abs(facing.x * 0.7 + facing.y * 0.7);
        }
        material.shade = vec4(lit * materialParams.lightIntensity * materialParams.lightColor, 1.0);

        material.worldPosition =
            materialParams.matrix * vec4(footprint, z * materialParams.heightFactor, 1.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 paint = materialParams.color * materialParams.opacity;
        material.baseColor = vec4(paint.rgb * variable_shade.rgb, paint.a);
    }
}
