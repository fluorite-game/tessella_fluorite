// SPDX-License-Identifier: Apache-2.0
//
// The clip mask, raised onto the terrain under its tile.
//
// `mask.mat`'s quad, lifted the way everything it clips is lifted. A mask drawn flat is the
// tile's square at height zero, and a raised tile is not there: every drawable standing on the
// ground was clipped back to where its tile would sit on a flat map, and the ground showed through
// the difference -- a gap at every tile boundary that widened with the exaggeration, and the whole
// of a layer raised from a coarser DEM cut away.
//
// Drawn on the grid the drawables are split on, with the same height read, so its edge is the
// same chord their edges are. A mask on a coarser grid bulges past them or falls short, and cuts
// a sliver off every tile.
material {
    name : tessella_mask_terrain,
    shadingModel : unlit,
    blending : opaque,
    culling : none,
    parameters : [
        { type : float4,    name : color },
        { type : float,     name : opacity },
        // Tile-local to clip, the stencil record's own -- no layer bias, which a mask does not
        // take part in.
        { type : mat4,      name : matrix },
        // The raise block of the tile's drawables, and the elevation they sample.
        { type : sampler2d, name : elevation },
        { type : float4,    name : unpack },
        { type : float4,    name : params },
        // The ground under the camera's center, in meters -- see `terrain_height.glsl`. The mask
        // has to stand where the surface stands, so it takes the same shift.
        { type : float,     name : center },
        // How far the curtain hangs, in meters. See the note on the skirt in `terrain.mat`.
        { type : float,     name : skirt }
    ],
    requires : [ position, custom0 ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec2 position = getPosition().xy;
        // `terrain.mat`'s read: the encoding's dot product over channels scaled back to bytes,
        // times the exaggeration. No skirt -- the mask covers the surface, not the seam under it.
        vec3 channels = texture(materialParams_elevation,
                                position * materialParams.params.x + materialParams.params.yz).rgb
                      * 255.0;
        float height = (channels.r * materialParams.unpack.r
                      + channels.g * materialParams.unpack.g
                      + channels.b * materialParams.unpack.b
                      - materialParams.unpack.a
                      - materialParams.center) * materialParams.params.w;
        // And the curtain, which is the whole reason the grid carries a flag: a mask cut to the
        // surface clips the skirt of every drawable it admits, and the seam stays open.
        height -= getCustom0().x * materialParams.skirt;
        material.worldPosition = materialParams.matrix * vec4(position, height, 1.0);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(0.0);
    }
}
