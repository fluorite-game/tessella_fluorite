// SPDX-License-Identifier: Apache-2.0
//
// The fill family, constant-paint permutation.
//
// No vertex hook and no matrix parameter. A material that writes `material.worldPosition` does not
// move its geometry -- proved in the two-quad harness, under both vertex domains, with the vertex
// stage demonstrably reading the parameter -- so tessella's tile-local-to-clip matrix goes onto
// the renderable's own transform through `TransformManager`, which Filament does apply. The
// camera is identity in view and projection, so `clip = transform * position` is the whole of it.
material {
    name : tessella_fill,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    parameters : [
        { type : float4, name : color },
        { type : float,  name : opacity }
    ],
    requires : [ position ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Straight alpha. Filament's transparent mode composites the source already multiplied,
        // so multiplying here as well darkens the result once per composite -- invisible where a
        // single layer covers a pixel and compounding wherever layers stack, which is what the
        // banding across liberty was: 133,033 pixels of a grey the oracle never produces, gone the
        // moment this stopped double-multiplying.
        material.baseColor = materialParams.color * materialParams.opacity;
    }
}
