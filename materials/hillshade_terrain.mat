// SPDX-License-Identifier: Apache-2.0
//
// A hillshade, raised onto the terrain it shades.
//
// `hillshade.mat` with one difference: the quad's corners are lifted to the ground's own height
// before the matrix places them, so the shading sits on the surface instead of under it. The
// arithmetic that reads a height is `terrain.mat`'s, from the same block at the same slot -- a
// layer standing on the ground and the ground itself have to agree about where the ground is, and
// reading the same numbers the same way is how that is made certain rather than hoped for.
//
// This is the first family raised beside the surface, and the one that makes a terrain legible:
// the ground is painted the style's background color and shows no shape on its own, so until
// something shades it there is nothing to look at.
//
// # Why the quad is a grid
//
// A raster quad is four corners on a plane. Four corners on a *terrain* chord straight through
// every ridge between them, so the producer builds this one on the terrain mesh's own grid --
// `Surface::Terrain` carries the cell count. Coarser than the surface it would float above it;
// finer it would chord against the surface's own chords.

material {
    name : tessella_hillshade_terrain,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    parameters : [
        { type : mat4,      name : matrix },
        // The tile's north and south edges in degrees, for the Mercator correction.
        { type : float2,    name : latrange },
        { type : float,     name : exaggeration },
        { type : float4,    name : accent },
        // Which method, and how many of the four lights it may read. Both come off the tile
        // props, where mbgl keeps them.
        { type : int,       name : method },
        { type : int,       name : numLights },
        // One component per light. Radians, both, and the azimuths already turned by the
        // camera's bearing where the style anchored the light to the viewport -- the producer
        // does that, because it is the one that knows.
        { type : float4,    name : altitudes },
        { type : float4,    name : azimuths },
        // One per light, named rather than an array: Filament flattens an array parameter of
        // `float4` into floats, so `shadows[1]` there is the second *component* of the first
        // colour rather than the second colour.
        { type : float4,    name : shadow0 },
        { type : float4,    name : shadow1 },
        { type : float4,    name : shadow2 },
        { type : float4,    name : shadow3 },
        { type : float4,    name : highlight0 },
        { type : float4,    name : highlight1 },
        { type : float4,    name : highlight2 },
        { type : float4,    name : highlight3 },
        { type : sampler2d, name : image },
        // The raw elevation this quad is raised from, and how to read it. Both arrive in the
        // block the ground itself reads, at the same slot -- see `terrain.mat`.
        { type : sampler2d, name : elevation },
        { type : float4,    name : unpack },
        { type : float4,    name : params },
        // The skirt, in meters, and three spare. Only the ground reads it.
        { type : float4,    name : skirt }
    ],
    requires : [ position, custom0, custom1 ],
    variables : [ hillshadeUv ]
}

vertex {
#include "terrain_height.glsl"
    void materialVertex(inout MaterialVertexInputs material) {
        vec2 position = getPosition().xy;
        // The ground's height at this corner. No skirt: this is a quad on the surface rather
        // than the surface.
        float height = terrainHeight(position);
        // The curtain, as the ground has one: a flagged vertex takes the surface's height and
        // then drops by the same skirt. Two tiles agree on a shared edge's world position and
        // reach it through different matrices, so the two land a fraction of a pixel apart and
        // the boundary pixels are claimed by neither -- on the ground that is a crack, and on a
        // picture drawn over the ground it is the ground showing through. See `add_skirt`.
        height -= getCustom1().x * materialParams.skirt.z;
        // int16 over 8192, the same EXTENT the positions use, which is what gives the quad enough
        // precision to sample at a fraction of a texel.
        material.hillshadeUv = vec4(getCustom0().xy / 8192.0, 0.0, 0.0);
        material.worldPosition = materialParams.matrix * vec4(position, height, 1.0);
    }
}

fragment {
#include "hillshade_light.glsl"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = variable_hillshadeUv.xy;
        vec4 pixel = texture(materialParams_image, uv);

        // Where this fragment is in latitude, and how much Mercator stretched it there.
        float latitude = (materialParams.latrange[0] - materialParams.latrange[1]) * (1.0 - uv.y)
                       + materialParams.latrange[1];
        float scaleFactor = cos(radians(latitude));

        // Back from the texture's [0, 1] to the slope's [-4, 4]: the prepare pass stored
        // `deriv / 8 + 0.5`, and this is that read backwards.
        vec2 deriv = ((pixel.rg * 8.0) - 4.0) / scaleFactor;

        material.baseColor = hillshadeLit(deriv);
    }
}
