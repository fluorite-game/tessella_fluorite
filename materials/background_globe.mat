// SPDX-License-Identifier: Apache-2.0
//
// The background family, bent onto a sphere -- plan.md §13.4's consumer half.
//
// This is the planet's own surface. Every other layer draws on top of it, so it is also the one
// that decides whether a globe reads as a sphere at all: bend everything else and leave this flat
// and the map is a rectangle with curved rivers on it.
//
// A globe never takes the viewport-background shortcut. `background_covers_viewport` is one quad
// over the whole frame with a matrix that does not consult the camera, which is exactly right for
// a clear and cannot be bent -- so the producer refuses it under `ProjectionMode::Globe` and emits
// the per-tile path instead, which is what this material draws.
//
// A separate material rather than a branch in `background.mat`, for the reason `fill_globe.mat`
// gives: the two differ in what a vertex is, and a uniform branch would put that fork on every
// vertex of every flat map to serve a mode most never enter.
//
// # The bend
//
// `tile-local -> normalized Mercator -> sphere -> clip`, transcribing `tessella-tile`'s
// `globe::sphere_point_from_mercator` rather than re-deriving it. See `fill_globe.mat` for the
// depth bias arriving in `merc.z`, and for where 32-bit float runs out (z11).
material {
    name : tessella_background_globe,
    shadingModel : unlit,
    blending : transparent,
    // The `y` flip in `globe::clip_matrix` reverses triangle winding, so a patch wound like a
    // Mercator one comes out back-facing. The far side of the planet is removed by the horizon
    // test rather than by a winding rule.
    culling : none,
    parameters : [
        { type : float4,   name : color },
        { type : float,    name : opacity },
        // Tile-local to normalized Mercator, with the depth bias in [3][2].
        { type : float4x4, name : matrix },
        // Unit sphere to clip.
        { type : float4x4, name : globeMatrix }
    ],
    requires : [ position ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // `PI` is Filament's own, from its shader prelude. Declaring one here shadows nothing
        // and expands to `const float 3.14159...`, which is a syntax error rather than a warning.

        // `merc.z` comes out as the depth bias: the input z is zero, so the only thing reaching it
        // is the matrix's own translation.
        vec4 merc = materialParams.matrix * vec4(getPosition().xy, 0.0, 1.0);

        float lon = merc.x * 360.0 - 180.0;
        float fraction = clamp(merc.y, 0.0, 1.0);
        // `camera::latitude_of`. The exponent's argument runs -PI..PI over the clamped fraction,
        // so this cannot overflow.
        float lat = atan(exp((180.0 - fraction * 360.0) * PI / 180.0)) * 360.0 / PI - 90.0;

        // `globe::sphere_point`, y negated: GL JS's convention, which `globe::clip_matrix` carries
        // the compensating flip for.
        float latR = lat * PI / 180.0;
        float lonR = lon * PI / 180.0;
        vec3 sphere = vec3(cos(latR) * sin(lonR), -sin(latR), cos(latR) * cos(lonR));

        vec4 clip = materialParams.globeMatrix * vec4(sphere, 1.0);
        clip.z += merc.z;
        material.worldPosition = clip;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Straight alpha, as `background.mat` writes it and for the same reason: Filament's
        // transparent mode composites the source already multiplied.
        material.baseColor = materialParams.color * materialParams.opacity;
    }
}
