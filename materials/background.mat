// SPDX-License-Identifier: Apache-2.0
//
// The background family, constant-paint permutation.
//
// No vertex hook and no matrix parameter. A material that writes `material.worldPosition` does not
// move its geometry -- proved in the two-quad harness, under both vertex domains, with the vertex
// stage demonstrably reading the parameter -- so tessella's tile-local-to-clip matrix goes onto
// the renderable's own transform through `TransformManager`, which Filament does apply. The
// camera is identity in view and projection, so `clip = transform * position` is the whole of it.
material {
    name : tessella_background,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    parameters : [
        { type : float4, name : color },
        { type : float,  name : opacity }
    ],
    requires : [ position ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Premultiplied, which is what Filament's transparent blending expects: it composites
        // src + dst*(1-a), so the colour must already carry its own alpha.
        float a = materialParams.color.a * materialParams.opacity;
        material.baseColor = vec4(materialParams.color.rgb * a, a);
    }
}
