// SPDX-License-Identifier: Apache-2.0
//
// The background family, plain-colour permutation.
//
// The simplest of them: `tsl_background_drawable_ubo` is a matrix and nothing else, and
// `tsl_background_props_ubo` a colour and an opacity. There is no per-vertex paint here at all,
// which is why the family declares one attribute and has exactly one non-pattern permutation.
//
// vertexDomain is device for the reason fill.mat gives: the matrix is mbgl's and already carries
// projection, so Filament's camera is identity and the transform happens here.
material {
    name : tessella_background,
    shadingModel : unlit,
    blending : transparent,
    depthWrite : false,
    culling : none,
    vertexDomain : device,
    parameters : [
        { type : mat4,   name : matrix },
        { type : float4, name : color },
        { type : float,  name : opacity }
    ],
    requires : [ position ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec4 clip = materialParams.matrix * getPosition();
        // The map is flat and depth is off, so the only thing z can do here is clip geometry
        // away: mbgl's matrix carries a depth range of its own and nothing downstream reads it.
        // Pinned inside the volume rather than trusted.
        material.worldPosition = vec4(clip.xy, 0.0, clip.w);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.color * materialParams.opacity;
    }
}
