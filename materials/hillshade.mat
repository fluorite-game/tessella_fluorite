// SPDX-License-Identifier: Apache-2.0
//
// The hillshade family: relief shaded from a slope field.
//
// The quad is a raster tile's quad and the attributes are its attributes. What it samples is not
// a picture but the *slope field* the producer cut from the tile's elevation -- a Sobel of the
// DEM, encoded with the x derivative in red and the y derivative in green over a range of
// [-4, 4]. mbgl computes that field in a GPU pass of its own per tile; this side computes it once
// on the CPU when the tile decodes, because every uniform that pass reads is a property of the
// tile and none of them is the camera's. So there is one texture here where mbgl has a render
// target, and the arithmetic below is the second half of its `hillshade.fragment.glsl`.
//
// # Mercator has to be undone first
//
// The slope field is in tile units, and a tile's ground width shrinks with the cosine of its
// latitude. Read straight, a hillshade in Svalbard would be three times as steep as the same
// ground at the equator. `latrange` is the tile's north and south edges and the fragment
// interpolates between them, which is what `scaleFactor` divides out.
//
// # Five methods and four lights
//
// `hillshade-method` chooses how the slopes are lit, and the numbering is mbgl's
// `HillshadeMethodType` rather than the spec's listing order: standard, combined, igor,
// multidirectional, basic. Only the multidirectional one reads more than the first light; the
// other four take a single azimuth and altitude and ignore the rest of the block.
//
// The arithmetic in each is transcribed from `hillshade.fragment.glsl` rather than derived. Two
// of them look wrong and are not: the standard method reads the *exaggeration* as an intensity,
// which mbgl's own comment calls out and does anyway, and the multidirectional one negates its
// azimuth where the others add pi. Changing either would be a different picture from the
// oracle's, which is the one thing this cannot be.
material {
    name : tessella_hillshade,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    parameters : [
        { type : mat4,      name : matrix },
        // The tile's north and south edges in degrees, for the Mercator correction.
        { type : float2,    name : latrange },
        { type : float,     name : exaggeration },
        { type : float4,    name : accent },
        // Which method, and how many of the four lights it may read. Both come off the tile
        // props, where mbgl keeps them.
        { type : int,       name : method },
        { type : int,       name : numLights },
        // One component per light. Radians, both, and the azimuths already turned by the
        // camera's bearing where the style anchored the light to the viewport -- the producer
        // does that, because it is the one that knows.
        { type : float4,    name : altitudes },
        { type : float4,    name : azimuths },
        // One per light, named rather than an array: Filament flattens an array parameter of
        // `float4` into floats, so `shadows[1]` there is the second *component* of the first
        // color rather than the second color.
        { type : float4,    name : shadow0 },
        { type : float4,    name : shadow1 },
        { type : float4,    name : shadow2 },
        { type : float4,    name : shadow3 },
        { type : float4,    name : highlight0 },
        { type : float4,    name : highlight1 },
        { type : float4,    name : highlight2 },
        { type : float4,    name : highlight3 },
        { type : sampler2d, name : image }
    ],
    requires : [ position, custom0 ],
    variables : [ hillshadeUv ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        vec2 position = getPosition().xy;
        // int16 over 8192, the same EXTENT the positions use, which is what gives the quad enough
        // precision to sample at a fraction of a texel.
        material.hillshadeUv = vec4(getCustom0().xy / 8192.0, 0.0, 0.0);
        material.worldPosition = materialParams.matrix * vec4(position, 0.0, 1.0);
    }
}

fragment {
#include "hillshade_light.glsl"

    void material(inout MaterialInputs material) {

        prepareMaterial(material);

        vec2 uv = variable_hillshadeUv.xy;
        vec4 pixel = texture(materialParams_image, uv);

        // Where this fragment is in latitude, and how much Mercator stretched it there.
        float latitude = (materialParams.latrange[0] - materialParams.latrange[1]) * (1.0 - uv.y)
                       + materialParams.latrange[1];
        float scaleFactor = cos(radians(latitude));

        // Back from the texture's [0, 1] to the slope's [-4, 4]: the prepare pass stored
        // `deriv / 8 + 0.5`, and this is that read backwards.
        vec2 deriv = ((pixel.rg * 8.0) - 4.0) / scaleFactor;

        material.baseColor = hillshadeLit(deriv);
    }
}
