// SPDX-License-Identifier: Apache-2.0
//
// The triangulated fill outline, bent onto a sphere directly -- plan.md §13.4's consumer half.
//
// `fill_outline_triangulated.mat` says why a fill's outline is a polyline here at all, and
// `fill_outline_globe.mat` says what the bend is and where it stops working (z11, measured). The
// one thing this file has to decide that neither of them does is where the sideways extrusion
// happens.
//
// It happens *before* the bend, in tile units, and the bent result is what is drawn. The flat
// material extrudes with the placement matrix applied to a direction; this bend is trig and has
// no linear part to do that with. So the ring point and the extruded point are bent separately
// and the difference between them is the projected extrusion -- two evaluations of the bend per
// vertex, which is what the exact answer costs. The anchored form above z10 pays one, by
// differentiating the expansion instead; this path is the low-zoom one, where a frame is a
// handful of tiles.
material {
    name : tessella_fill_outline_triangulated_globe,
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    parameters : [
        { type : float4,   name : color },
        { type : float,    name : opacity },
        { type : float,    name : ratio },
        { type : float,    name : pixelRatio },
        { type : float2,   name : unitsToPixels },
        // Tile-local to normalized Mercator, with the depth bias in [3][2].
        { type : float4x4, name : matrix },
        // Unit sphere to clip.
        { type : float4x4, name : globeMatrix }
    ],
    requires : [ position, custom0 ],
    variables : [ outlineEdge ]
}

vertex {
    // `globe::sphere_point_from_mercator` through `globe::clip_matrix`, transcribed -- the same
    // chain `fill_outline_globe.mat` walks inline, factored out here because this material walks
    // it twice.
    vec4 bend(vec2 tileLocal) {
        vec4 merc = materialParams.matrix * vec4(tileLocal, 0.0, 1.0);

        float lon = merc.x * 360.0 - 180.0;
        float fraction = clamp(merc.y, 0.0, 1.0);
        float lat = atan(exp((180.0 - fraction * 360.0) * PI / 180.0)) * 360.0 / PI - 90.0;

        float latR = lat * PI / 180.0;
        float lonR = lon * PI / 180.0;
        vec3 sphere = vec3(cos(latR) * sin(lonR), -sin(latR), cos(latR) * cos(lonR));

        vec4 clip = materialParams.globeMatrix * vec4(sphere, 1.0);
        // The depth bias, in clip space before the divide, which is where the Mercator path
        // applies it.
        clip.z += merc.z;
        return clip;
    }

    void materialVertex(inout MaterialVertexInputs material) {
        const float EXTRUDE_SCALE = 63.0;

        float antialiasing = 1.0 / max(materialParams.pixelRatio, 1e-6) / 2.0;

        vec2 posNormal = getPosition().xy;
        vec2 centre = floor(posNormal * 0.5);
        vec2 normal = posNormal - 2.0 * centre;
        normal.y = normal.y * 2.0 - 1.0;

        vec2 extrude = getCustom0().xy - 128.0;

        const float halfwidth = 0.5;
        float outset = halfwidth + antialiasing;

        vec2 dist = outset * extrude / EXTRUDE_SCALE;
        float ratio = max(materialParams.ratio, 1e-6);

        vec4 placed = bend(centre);
        vec4 clip = bend(centre + dist / ratio);
        vec4 projectedExtrude = clip - placed;

        float unprojected = length(dist);
        float projected = length(projectedExtrude.xy / clip.w * materialParams.unitsToPixels);
        float gammaScale = unprojected / max(projected, 1e-6);

        material.outlineEdge = vec4(normal, outset, gammaScale);
        material.worldPosition = clip;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 normal = variable_outlineEdge.xy;
        float width2 = variable_outlineEdge.z;
        float gammaScale = variable_outlineEdge.w;

        float dist = length(normal) * width2;
        float blur2 = (1.0 / max(materialParams.pixelRatio, 1e-6)) * gammaScale;
        float alpha = clamp(min(dist + blur2, width2 - dist) / blur2, 0.0, 1.0);

        material.baseColor = materialParams.color * (alpha * materialParams.opacity);
    }
}
