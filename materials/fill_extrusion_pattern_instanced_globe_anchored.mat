// SPDX-License-Identifier: Apache-2.0
//
// The patterned walls of a fill-extrusion, bent onto a sphere by the anchored expansion.
//
// `fill_extrusion_pattern_instanced.mat` says what this draws, what the edge distance is for and
// how it is shaded. None of that changes on a sphere, and neither does the sprite: a wall's
// pattern coordinate is `vec2(edgedistance, z * heightFactor)` in tile units, which a bend does
// not touch.
//
// What changes is the last line, as it does for the plain pair: the footprint comes from the
// expansion and the height rides on `bendH`, the clip displacement per meter at the anchor.
//
// Anchored only, and unverified against a frame, for the reasons
// `fill_extrusion_pattern_globe_anchored.mat` gives.
material {
    name : tessella_fill_extrusion_pattern_instanced_globe_anchored,
    shadingModel : unlit,
    blending : transparent,
    // Back faces, as mbgl culls them, and `front` for the reason `fill_extrusion.mat` gives.
    culling : front,
    parameters : [
        // `globe_ubo::GlobeBendUbo`, in declaration order, and the tile center it expands
        // about. This replaces the tile-to-clip matrix.
        { type : float2,    name : bendCenter },
        { type : float4,    name : bendAnchor },
        { type : float4,    name : bendU },
        { type : float4,    name : bendV },
        { type : float4,    name : bendUU },
        { type : float4,    name : bendVV },
        { type : float4,    name : bendUV },
        // Clip displacement per meter of height, at the anchor.
        { type : float4,    name : bendH },
        { type : float,     name : base },
        { type : float,     name : height },
        { type : float3,    name : lightColor },
        { type : float3,    name : lightPosition },
        { type : float,     name : lightIntensity },
        { type : float,     name : verticalGradient },
        { type : float,     name : baseT },
        { type : float,     name : heightT },
        { type : float2,    name : pixelCoordUpper },
        { type : float2,    name : pixelCoordLower },
        { type : float,     name : tileRatio },
        // Meters to the tile's own units, which only this family reads. See the note above.
        { type : float,     name : heightFactor },
        { type : float4,    name : patternFrom },
        { type : float4,    name : patternTo },
        { type : float2,    name : texsize },
        { type : float,     name : fromScale },
        { type : float,     name : toScale },
        { type : float,     name : fade },
        { type : float,     name : opacity },
        { type : float,     name : pixelRatio },
        { type : sampler2d, name : image0 }
    ],
    // `custom2` is skipped: that is the plain wall's color attribute, and this family reads none.
    // `custom3` is the edge distance, which no other wall shader wants.
    requires : [ position, custom0, custom1, custom3 ],
    variables : [ lighting, patternPosA, patternPosB ]
}

vertex {
    /// Where a vertex falls within the pattern's period, in pattern widths.
    ///
    /// The triple `mod` is mbgl's and is not redundant: it reduces the high half of the world
    /// coordinate against the pattern size *before* multiplying it up by 256 twice, so the product
    /// never leaves the range a float can hold exactly.
    vec2 patternPos(vec2 upper, vec2 lower, vec2 size, float unitsToPixels, vec2 pos) {
        vec2 offset = mod(mod(mod(upper, size) * 256.0, size) * 256.0 + lower, size);
        return (unitsToPixels * pos + offset) / size;
    }

    void materialVertex(inout MaterialVertexInputs material) {
        vec3 placed = getPosition().xyz;
        vec2 footprint = placed.xy;
        // Which ring this vertex belongs to: zero is the base, one the roof.
        float t = placed.z;

        // The edge's facing, in the ground plane, so the z component is zero.
        vec3 normal = vec3(getCustom0().xy, 0.0);

        // Base and height at the lower zoom stop, then at the upper, with NaN meaning the layer
        // did not drive the property -- `fill_extrusion_instanced.mat` says why.
        vec4 extent = getCustom1();
        float base = max(extent.x != extent.x ? materialParams.base
                                              : mix(extent.x, extent.z, materialParams.baseT),
                         0.0);
        float height = max(extent.y != extent.y ? materialParams.height
                                                : mix(extent.y, extent.w, materialParams.heightT),
                           0.0);
        float z = t > 0.0 ? height : base;

        vec2 tlA = materialParams.patternFrom.xy;
        vec2 brA = materialParams.patternFrom.zw;
        vec2 tlB = materialParams.patternTo.xy;
        vec2 brB = materialParams.patternTo.zw;
        float ratio = max(materialParams.pixelRatio, 1e-6);
        vec2 sizeA = (brA - tlA) / ratio;
        vec2 sizeB = (brB - tlB) / ratio;

        // Along the ring and up the wall, in tile units. See the note at the top of this file.
        vec2 along = vec2(getCustom3().x, z * materialParams.heightFactor);
        material.patternPosA = vec4(
            patternPos(materialParams.pixelCoordUpper, materialParams.pixelCoordLower,
                       materialParams.fromScale * sizeA, materialParams.tileRatio, along),
            0.0, 0.0);
        material.patternPosB = vec4(
            patternPos(materialParams.pixelCoordUpper, materialParams.pixelCoordLower,
                       materialParams.toScale * sizeB, materialParams.tileRatio, along),
            0.0, 0.0);

        // The shading range is a constant rather than the surface's luminance, for the reason
        // `fill_extrusion_pattern.mat` gives: there is no surface color to read.
        float directionalFraction = clamp(dot(normal, materialParams.lightPosition), 0.0, 1.0);
        float minDirectional = 1.0 - materialParams.lightIntensity;
        float maxDirectional = max(0.5 + materialParams.lightIntensity, 1.0);
        float directional = mix(minDirectional, maxDirectional, directionalFraction);

        // The gradient down a wall, which is the branch a roof's normal never reaches.
        if (normal.z == 0.0) {
            float fMin = mix(0.7, 0.98, 1.0 - materialParams.lightIntensity);
            float factor = clamp((t + base) * pow(height / 150.0, 0.5), fMin, 1.0);
            directional *= (1.0 - materialParams.verticalGradient)
                         + (materialParams.verticalGradient * factor);
        }

        vec3 minLight = mix(vec3(0.0), vec3(0.3), 1.0 - materialParams.lightColor);
        vec3 lit = clamp(directional * materialParams.lightColor, minLight, vec3(1.0));

        material.lighting = vec4(lit, 1.0) * materialParams.opacity;
        // `z` straight, not scaled by the height factor: that factor is the texture coordinate's
        // above and mbgl never places geometry with it.
        // The footprint through the expansion, then the height along the normal. `z` is meters,
        // which is what `bendH` is per unit of -- a plane folds the same factor into its matrix's
        // `z` column.
        vec2 d = footprint - materialParams.bendCenter;
        vec4 bent = materialParams.bendAnchor
                  + materialParams.bendU * d.x
                  + materialParams.bendV * d.y
                  + 0.5 * (materialParams.bendUU * (d.x * d.x)
                         + materialParams.bendVV * (d.y * d.y))
                  + materialParams.bendUV * (d.x * d.y);
        material.worldPosition = bent + materialParams.bendH * z;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 tlA = materialParams.patternFrom.xy;
        vec2 brA = materialParams.patternFrom.zw;
        vec2 tlB = materialParams.patternTo.xy;
        vec2 brB = materialParams.patternTo.zw;

        vec2 within = mod(variable_patternPosA.xy, 1.0);
        vec2 a = mix(tlA / materialParams.texsize, brA / materialParams.texsize, within);
        vec4 color1 = texture(materialParams_image0, a);

        vec2 withinB = mod(variable_patternPosB.xy, 1.0);
        vec2 b = mix(tlB / materialParams.texsize, brB / materialParams.texsize, withinB);
        vec4 color2 = texture(materialParams_image0, b);

        material.baseColor = mix(color1, color2, materialParams.fade) * variable_lighting;
    }
}
