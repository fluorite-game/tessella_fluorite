# Per example rather than per named example: the build outputs are the same whichever app
# writes them, and a second example that spelled its own out would be a second place to forget.
example/*/.dart_tool/
example/*/.flutter-plugins*
example/*/pubspec.lock
.dart_tool/
pubspec.lock
example/*/build/
build-arm64/
example/*/libapp.so.release*
emb.lock

# The render probe and the example app write their tile cache into the working
# directory. It was tracked, and a 5.7 MB binary that changes on every run is four
# commits of noise in the history for a file nothing reads back.
cache.sqlite
cache.sqlite-journal
cache.sqlite-wal
cache.sqlite-shm
