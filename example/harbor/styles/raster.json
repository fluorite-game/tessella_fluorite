{
  "version": 8,
  "name": "Raster under vector",
  "glyphs": "http://127.0.0.1:8081/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "hk": {
      "type": "vector",
      "url": "http://127.0.0.1:8080/hongkong_z15.json"
    },
    "img": {
      "type": "raster",
      "tiles": [
        "http://127.0.0.1:8081/raster/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 16
    }
  },
  "layers": [
    {
      "id": "ground",
      "type": "background",
      "paint": {
        "background-color": "#10141c"
      }
    },
    {
      "id": "imagery",
      "type": "raster",
      "source": "img",
      "paint": {
        "raster-opacity": 0.85,
        "raster-saturation": -0.35,
        "raster-contrast": 0.15,
        "raster-hue-rotate": 150,
        "raster-brightness-min": 0.05,
        "raster-brightness-max": 0.9,
        "raster-resampling": "linear",
        "raster-fade-duration": 300
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "hk",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0f3350",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "hk",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "park",
          "forest",
          "nature_reserve",
          "garden"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#2e6b40",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "!=",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "highway",
          "#ffe6b0",
          "major_road",
          "#fff6dc",
          "#e8e4d8"
        ],
        "line-opacity": 0.9,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.5,
          15,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "highway",
            6,
            "major_road",
            4,
            1.6
          ]
        ]
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "hk",
      "source-layer": "places",
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "match",
          [
            "get",
            "kind_detail"
          ],
          [
            "city",
            "town",
            "suburb",
            "quarter"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "match",
          [
            "get",
            "kind"
          ],
          "locality",
          16,
          12
        ],
        "symbol-sort-key": [
          "match",
          [
            "get",
            "kind_detail"
          ],
          "city",
          0,
          "town",
          1,
          "suburb",
          2,
          "quarter",
          3,
          "neighbourhood",
          4,
          "village",
          5,
          "hamlet",
          6,
          "locality",
          7,
          8
        ]
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "#0b1018",
        "text-halo-width": 1.8
      }
    }
  ]
}