{
  "version": 8,
  "name": "Victoria Harbour, day",
  "glyphs": "http://127.0.0.1:8081/glyphs/{fontstack}/{range}.pbf",
  "sprite": "http://127.0.0.1:8081/sprites/emerald",
  "sources": {
    "hk": {
      "type": "vector",
      "url": "http://127.0.0.1:8086/cities.json"
    }
  },
  "layers": [
    {
      "id": "sea",
      "type": "background",
      "paint": {
        "background-color": "#a8c8dd"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "hk",
      "source-layer": "earth",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#f3efe4"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "hk",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "forest",
          "#cadcb6",
          "scrub",
          "#d9e3c4",
          "grassland",
          "#dfe8cb",
          "urban_area",
          "#ece7dc",
          "farmland",
          "#e6e6c8",
          "#e9e5d8"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "hk",
      "source-layer": "landuse",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "park",
          "forest",
          "nature_reserve",
          "cemetery",
          "golf_course",
          "pitch",
          "garden"
        ],
        true,
        false
      ],
      "paint": {
        "fill-color": "#c3dcae",
        "fill-opacity": 0.9,
        "fill-outline-color": "#a8c694"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "hk",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#9cc3dc",
        "fill-outline-color": "#7fadcb"
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "!=",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#cfc6b4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "highway",
            4,
            "major_road",
            3,
            1
          ],
          16,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "highway",
            18,
            "major_road",
            13,
            "medium_road",
            9,
            "minor_road",
            6,
            2.5
          ]
        ]
      }
    },
    {
      "id": "road-fill",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "!=",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "highway",
          "#fdd9a0",
          "major_road",
          "#fdefc8",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "highway",
            2.4,
            "major_road",
            1.6,
            0.4
          ],
          16,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "highway",
            13,
            "major_road",
            9.5,
            "medium_road",
            6.5,
            "minor_road",
            4,
            1.5
          ]
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#9e9a90",
        "line-width": 1.4,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "ferry",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "ferry"
      ],
      "paint": {
        "line-color": "#5c8fae",
        "line-width": 1.6,
        "line-dasharray": [
          2,
          3
        ],
        "line-opacity": 0.35
      }
    },
    {
      "id": "buildings-plain",
      "type": "fill-extrusion",
      "source": "hk",
      "source-layer": "buildings",
      "filter": [
        "all",
        [
          "!",
          [
            "has",
            "height"
          ]
        ],
        [
          "==",
          [
            "get",
            "kind"
          ],
          "building"
        ]
      ],
      "paint": {
        "fill-extrusion-height": 11,
        "fill-extrusion-base": 0,
        "fill-extrusion-color": "#ebe2d2",
        "fill-extrusion-opacity": 0.95,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "buildings-measured",
      "type": "fill-extrusion",
      "source": "hk",
      "source-layer": "buildings",
      "filter": [
        "all",
        [
          "has",
          "height"
        ],
        [
          "==",
          [
            "get",
            "kind"
          ],
          "building"
        ]
      ],
      "paint": {
        "fill-extrusion-height": [
          "get",
          "height"
        ],
        "fill-extrusion-base": [
          "case",
          [
            "has",
            "min_height"
          ],
          [
            "get",
            "min_height"
          ],
          0
        ],
        "fill-extrusion-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "height"
          ],
          0,
          "#f2e9d8",
          40,
          "#e8d7ba",
          100,
          "#dcc39c",
          200,
          "#d3bda2",
          400,
          "#dde3e9"
        ],
        "fill-extrusion-opacity": 0.95,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "poi-dots",
      "type": "circle",
      "source": "hk",
      "source-layer": "pois",
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "<=",
          [
            "get",
            "min_zoom"
          ],
          15
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "ferry_terminal",
            "pier",
            "station",
            "museum",
            "hotel",
            "attraction",
            "viewpoint",
            "monument",
            "park",
            "hospital",
            "university",
            "theatre",
            "mall",
            "marketplace"
          ],
          true,
          false
        ]
      ],
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          2.5,
          16,
          5
        ],
        "circle-color": "#c0453a",
        "circle-stroke-width": 1.2,
        "circle-stroke-color": "#ffffff",
        "circle-opacity": 0.9
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "match",
          [
            "get",
            "kind"
          ],
          [
            "highway",
            "major_road",
            "medium_road"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#5a5245",
        "text-halo-color": "#fbf8f0",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "hk",
      "source-layer": "water",
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "==",
          [
            "get",
            "kind"
          ],
          "ocean"
        ]
      ],
      "layout": {
        "text-field": [
          "format",
          [
            "coalesce",
            [
              "get",
              "name:en"
            ],
            [
              "get",
              "name"
            ]
          ],
          {
            "font-scale": 1.1
          },
          "\n",
          {},
          [
            "coalesce",
            [
              "get",
              "name:zh-Hant"
            ],
            [
              "get",
              "name"
            ]
          ],
          {
            "font-scale": 0.9
          }
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 14,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#33627f",
        "text-halo-color": "#d7e8f2",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "hk",
      "source-layer": "places",
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "match",
          [
            "get",
            "kind_detail"
          ],
          [
            "city",
            "town",
            "suburb",
            "quarter",
            "neighbourhood",
            "village"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "text-field": [
          "format",
          [
            "coalesce",
            [
              "get",
              "name:en"
            ],
            [
              "get",
              "name"
            ]
          ],
          {
            "font-scale": 1.0
          },
          "\n",
          {},
          [
            "coalesce",
            [
              "get",
              "name:zh-Hant"
            ],
            [
              "get",
              "name"
            ]
          ],
          {
            "font-scale": 0.85
          }
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "match",
          [
            "get",
            "kind"
          ],
          "locality",
          17,
          "neighbourhood",
          13,
          12
        ],
        "text-max-width": 9,
        "symbol-sort-key": [
          "match",
          [
            "get",
            "kind_detail"
          ],
          "city",
          0,
          "town",
          1,
          "suburb",
          2,
          "quarter",
          3,
          "neighbourhood",
          4,
          "village",
          5,
          "hamlet",
          6,
          "locality",
          7,
          8
        ]
      },
      "paint": {
        "text-color": "#2b261f",
        "text-halo-color": "#fdfbf5",
        "text-halo-width": 1.6
      }
    }
  ]
}