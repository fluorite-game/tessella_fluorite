{
  "version": 8,
  "name": "Victoria Harbour, night",
  "glyphs": "http://127.0.0.1:8081/glyphs/{fontstack}/{range}.pbf",
  "sprite": "http://127.0.0.1:8081/sprites/emerald",
  "sources": {
    "hk": {
      "type": "vector",
      "url": "http://127.0.0.1:8080/hongkong_z15.json"
    }
  },
  "layers": [
    {
      "id": "night",
      "type": "background",
      "paint": {
        "background-color": "#05080f"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "hk",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#0c1119"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "hk",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "forest",
          "#0d1a16",
          "scrub",
          "#101a16",
          "urban_area",
          "#141a24",
          "#101621"
        ],
        "fill-opacity": 0.9
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "hk",
      "source-layer": "water",
      "paint": {
        "fill-color": "#030711",
        "fill-outline-color": "#1d4b6b"
      }
    },
    {
      "id": "road-glow",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "highway",
          "major_road",
          "medium_road"
        ],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "highway",
          "#ff9a3c",
          "#4fa8ff"
        ],
        "line-blur": 6,
        "line-opacity": 0.55,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          4,
          16,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "highway",
            22,
            "major_road",
            15,
            10
          ]
        ]
      }
    },
    {
      "id": "road-core",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "!=",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "highway",
          "#ffd9a8",
          "major_road",
          "#cfe6ff",
          "#6d7f96"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.6,
          16,
          [
            "match",
            [
              "get",
              "kind"
            ],
            "highway",
            5,
            "major_road",
            3.4,
            "medium_road",
            2.2,
            1.2
          ]
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#2fd6c8",
        "line-width": 1.3,
        "line-dasharray": [
          1,
          2
        ],
        "line-opacity": 0.8
      }
    },
    {
      "id": "towers-plain",
      "type": "fill-extrusion",
      "source": "hk",
      "source-layer": "buildings",
      "filter": [
        "all",
        [
          "!",
          [
            "has",
            "height"
          ]
        ],
        [
          "==",
          [
            "get",
            "kind"
          ],
          "building"
        ]
      ],
      "paint": {
        "fill-extrusion-height": 9,
        "fill-extrusion-base": 0,
        "fill-extrusion-color": "#161d2b",
        "fill-extrusion-opacity": 0.94,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "towers-measured",
      "type": "fill-extrusion",
      "source": "hk",
      "source-layer": "buildings",
      "filter": [
        "all",
        [
          "has",
          "height"
        ],
        [
          "==",
          [
            "get",
            "kind"
          ],
          "building"
        ]
      ],
      "paint": {
        "fill-extrusion-height": [
          "get",
          "height"
        ],
        "fill-extrusion-base": [
          "case",
          [
            "has",
            "min_height"
          ],
          [
            "get",
            "min_height"
          ],
          0
        ],
        "fill-extrusion-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "height"
          ],
          0,
          "#18263c",
          30,
          "#1f3f66",
          80,
          "#2f78b8",
          160,
          "#63b4ea",
          280,
          "#b6e6ff",
          420,
          "#ffe6a8"
        ],
        "fill-extrusion-opacity": 0.96,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "lights",
      "type": "circle",
      "source": "hk",
      "source-layer": "pois",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "bar",
          "pub",
          "nightclub",
          "restaurant",
          "cafe",
          "hotel"
        ],
        true,
        false
      ],
      "paint": {
        "circle-radius": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          2,
          16,
          7
        ],
        "circle-color": [
          "match",
          [
            "get",
            "kind"
          ],
          "bar",
          "#ff4f8b",
          "pub",
          "#ff7a4f",
          "nightclub",
          "#c86bff",
          "restaurant",
          "#ffc24f",
          "cafe",
          "#ffe08a",
          "#8ad7ff"
        ],
        "circle-blur": 0.9,
        "circle-opacity": 0.85,
        "circle-pitch-alignment": "map"
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "hk",
      "source-layer": "places",
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "match",
          [
            "get",
            "kind_detail"
          ],
          [
            "city",
            "town",
            "suburb",
            "quarter",
            "neighbourhood",
            "village"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "text-field": [
          "format",
          [
            "coalesce",
            [
              "get",
              "name:en"
            ],
            [
              "get",
              "name"
            ]
          ],
          {
            "font-scale": 1.0
          },
          "\n",
          {},
          [
            "coalesce",
            [
              "get",
              "name:zh-Hant"
            ],
            [
              "get",
              "name"
            ]
          ],
          {
            "font-scale": 0.85
          }
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "match",
          [
            "get",
            "kind"
          ],
          "locality",
          18,
          "neighbourhood",
          13,
          12
        ],
        "text-letter-spacing": 0.12,
        "text-max-width": 9,
        "symbol-sort-key": [
          "match",
          [
            "get",
            "kind_detail"
          ],
          "city",
          0,
          "town",
          1,
          "suburb",
          2,
          "quarter",
          3,
          "neighbourhood",
          4,
          "village",
          5,
          "hamlet",
          6,
          "locality",
          7,
          8
        ]
      },
      "paint": {
        "text-color": "#e8f3ff",
        "text-halo-color": "#04070d",
        "text-halo-width": 1.8,
        "text-halo-blur": 0.6
      }
    }
  ]
}