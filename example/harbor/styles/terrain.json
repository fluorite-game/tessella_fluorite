{
  "version": 8,
  "name": "The Peak above the harbor",
  "glyphs": "http://127.0.0.1:8081/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "hk": {
      "type": "vector",
      "url": "http://127.0.0.1:8080/hongkong_z15.json"
    },
    "dem": {
      "type": "raster-dem",
      "encoding": "terrarium",
      "tileSize": 256,
      "minzoom": 8,
      "maxzoom": 14,
      "tiles": [
        "http://127.0.0.1:8085/{z}/{x}/{y}.png"
      ]
    }
  },
  "terrain": {
    "source": "dem",
    "exaggeration": 1.3
  },
  "layers": [
    {
      "id": "sky",
      "type": "background",
      "paint": {
        "background-color": "#9fb7c9"
      }
    },
    {
      "id": "relief",
      "type": "color-relief",
      "source": "dem",
      "paint": {
        "color-relief-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "elevation"
          ],
          0,
          "#cdc3a6",
          25,
          "#b9c48d",
          90,
          "#93ab6f",
          200,
          "#86a068",
          380,
          "#9a9468",
          560,
          "#b6a888",
          780,
          "#d8cfbb",
          960,
          "#f2eee4"
        ]
      }
    },
    {
      "id": "shade",
      "type": "hillshade",
      "source": "dem",
      "paint": {
        "hillshade-exaggeration": 0.45
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "hk",
      "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": {
        "fill-color": "#24617f"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "hk",
      "source-layer": "roads",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "highway",
          "major_road"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#f3e6c6",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.6,
          15,
          3.5
        ],
        "line-opacity": 0.85
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "hk",
      "source-layer": "places",
      "filter": [
        "all",
        [
          "has",
          "name"
        ],
        [
          "match",
          [
            "get",
            "kind_detail"
          ],
          [
            "city",
            "town",
            "suburb"
          ],
          true,
          false
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "match",
          [
            "get",
            "kind_detail"
          ],
          "city",
          17,
          "town",
          14,
          12
        ],
        "symbol-sort-key": [
          "match",
          [
            "get",
            "kind_detail"
          ],
          "city",
          0,
          "town",
          1,
          2
        ]
      },
      "paint": {
        "text-color": "#23303a",
        "text-halo-color": "#f6f2e8",
        "text-halo-width": 1.8
      }
    }
  ]
}